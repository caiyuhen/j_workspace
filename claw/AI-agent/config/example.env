# 环境变量示例
# 复制此文件为 .env 并填写实际值

# ============ SkillHub.cn 配置 ============
# SkillHub.cn API 密钥
SKILLHUB_API_KEY=your_skillhub_api_key_here

# ============ MCP 配置 ============
# GitHub Token (用于 MCP GitHub 服务器)
GITHUB_TOKEN=your_github_token_here

# ============ 数据库配置 ============
# SQLite 数据库路径
DATABASE_PATH=./data/database.db

# PostgreSQL (可选，用于生产环境)
# DATABASE_URL=postgresql://user:password@localhost:5432/medical_agent

# ============ 监控系统配置 ============
# 监控服务地址 (可选)
# MONITORING_URL=http://localhost:9090

# ============ 通知配置 ============
# 企业微信 Webhook (用于告警通知)
# WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY

# 钉钉 Webhook (可选)
# DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?token=YOUR_TOKEN

# ============ 安全配置 ============
# API 密钥 (用于保护 API 接口)
API_SECRET_KEY=your_api_secret_key_here

# JWT 密钥 (用于认证)
JWT_SECRET=your_jwt_secret_key_here

# ============ 工作目录配置 ============
# 主工作目录
WORKSPACE_PATH=D:/workspace/claw/AI-agent

# 备份目录
BACKUP_PATH=D:/workspace/claw/AI-agent/backup

# ============ 日志配置 ============
# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 日志文件路径
LOG_PATH=./logs

# ============ Token 计算配置 ============
# Token 定价 (元/千 token)
TOKEN_PRICE_INPUT=0.002
TOKEN_PRICE_OUTPUT=0.006

# Token 使用限制
TOKEN_DAILY_LIMIT=1000000
TOKEN_MONTHLY_LIMIT=30000000

# ============ 大模型配置 ============
# 大模型基础 URL
MODEL_BASE_URL=http://192.168.0.214:8802/chat/

# 默认模型名称
MODEL_DEFAULT=qwen3.5-35b-a3b

# ============ 其他配置 ============
# 服务器端口
SERVER_PORT=8080

# 是否启用调试模式
DEBUG=false

# 时区
TIMEZONE=Asia/Shanghai
