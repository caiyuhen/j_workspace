# ============================================
# CTMS Pro 后端环境配置
# 复制此文件为 .env 并修改对应值
# ============================================

# 应用配置
APP_NAME=CTMS Pro
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production-min-32chars
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:8899","http://127.0.0.1:8899","http://localhost:3000"]

# 数据库配置 (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ctms_user
POSTGRES_PASSWORD=ctms2026
POSTGRES_DB=ctms_pro
DATABASE_URL=postgresql+asyncpg://ctms_user:ctms2026@localhost:5432/ctms_pro

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# JWT 配置
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# 邮件配置
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.example.com
SMTP_USER=noreply@ctms-pro.com
SMTP_PASSWORD=your-smtp-password
EMAILS_FROM_EMAIL=noreply@ctms-pro.com
EMAILS_FROM_NAME=CTMS Pro

# 文件存储 (S3/MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=ctms-documents
S3_REGION=us-east-1

# Celery 任务队列
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# 审计日志保留天数
AUDIT_LOG_RETENTION_DAYS=180

# 超管初始账号 (仅首次部署使用)
FIRST_SUPERUSER=admin@ctms-pro.com
FIRST_SUPERUSER_PASSWORD=Admin@CTMS2026!
