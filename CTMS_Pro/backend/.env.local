# CTMS Pro 后端环境配置
APP_NAME=CTMS Pro
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True
SECRET_KEY=ctms-pro-secret-key-2026-dev-only-32chars
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:8899","http://127.0.0.1:8899"]

# 数据库配置
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ctms_user
POSTGRES_PASSWORD=ctms2026
POSTGRES_DB=ctms_pro
DATABASE_URL=postgresql+asyncpg://ctms_user:ctms2026@localhost:5432/ctms_pro

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# JWT 配置
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# 超管初始账号
FIRST_SUPERUSER=admin@ctms-pro.com
FIRST_SUPERUSER_PASSWORD=Admin@CTMS2026!
