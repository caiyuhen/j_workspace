# 应用配置
APP_NAME=Medical Agent System
DEBUG=True

# 数据库配置
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medical_agent

# Redis配置
REDIS_URL=redis://localhost:6379/0

# LLM服务配置（内置RAG）
# 基础地址：实际对话接口为 POST {LLM_ENDPOINT}/chat
# 该服务已内置RAG能力，包含医学知识向量库
LLM_ENDPOINT=http://127.0.0.1:8802
LLM_MODEL=medical-large
LLM_TIMEOUT=300000

# JWT配置
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Skill配置
SKILLHUB_API_KEY=
SKILLHUB_ENDPOINT=https://api.skillhub.cn

# 日志配置
LOG_LEVEL=INFO
