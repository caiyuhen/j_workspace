# Environment Variables for CTMS+EDC System v4.0
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=3000
HOST=localhost

# PostgreSQL Database (Main)
DATABASE_URL="postgresql://postgres:root@123@localhost:5432/ctms_edc?schema=public"

# JWT Secret
JWT_SECRET=ctms-edc-super-secret-key-change-in-production-2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# LLM Service (Internal)
LLM_BASE_URL=http://192.168.0.126:8802/write/
LLM_ENDPOINT=/chat
LLM_MODEL=custom-llm

# WeChat/WeCom (Optional)
WECHAT_CORP_ID=ww_xxx
WECHAT_AGENT_ID=1000001
WECOM_CORP_SECRET=your_corp_secret

# Compliance
COMPLIANCE_21CFR_PART11_ENABLED=true
COMPLIANCE_ALCOA_PLUS_ENABLED=true
