  fieldMappings   Json      @default("{}") @map("field_mappings") @db.Json
  isActive        Boolean?  @default(true) @map("is_active")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([projectId, domain])
  @@index([projectId], map: "idx_sdtm_export_configs_project")
  @@map("sdtm_export_configs")
}

model SdtmExport {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id") @db.VarChar(36)
  exportConfig String   @map("export_config")
  data         String
  status       String   @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId])
  @@map("sdtm_exports")
}

model DoctorPatientRecord {
  id               String                 @id @default(uuid())
  doctorId         String                 @map("doctor_id") @db.VarChar(36)
  patientName      String                 @map("patient_name") @db.VarChar(255)
  gender           String                 @db.VarChar(20)
  dateOfBirth      DateTime?              @map("date_of_birth") @db.Date
  contactInfo      String?
  diagnosis        String?
  treatmentHistory Json?                  @map("treatment_history")
  patientTags      Json?                  @map("patient_tags")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  doctor           User                   @relation(fields: [doctorId], references: [id])
  followUpRecords  DoctorFollowUpRecord[]

  @@index([doctorId])
  @@map("doctor_patient_records")
}

model DoctorFollowUpRecord {
  id               String              @id @default(uuid())
  patientRecordId  String              @map("patient_record_id") @db.VarChar(36)
  visitDate        DateTime            @map("visit_date") @db.Date
  visitType        String              @map("visit_type") @db.VarChar(100)
  formTemplateId   String?             @map("form_template_id") @db.VarChar(36)
  formTemplateName String?             @map("form_template_name") @db.VarChar(255)
  data             Json
  status           String              @default("active") @db.VarChar(50)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  patientRecord    DoctorPatientRecord @relation(fields: [patientRecordId], references: [id], onDelete: Cascade)

  @@index([patientRecordId])
  @@map("doctor_follow_up_records")
}

model DoctorFormTemplate {
  id                 String   @id @default(uuid())
  templateName       String   @map("template_name") @db.VarChar(255)
  templateType       String   @map("template_type") @db.VarChar(50)
  fields             Json
  usedInDoctorFolder Boolean  @default(true) @map("used_in_doctor_folder")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("doctor_form_templates")
}
