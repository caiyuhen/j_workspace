generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(uuid())
  username          String              @unique @db.VarChar(100)
  email             String              @unique @db.VarChar(200)
  passwordHash      String              @map("password_hash") @db.VarChar(255)
  displayName       String              @map("display_name") @db.VarChar(200)
  phone             String?             @db.VarChar(50)
  title             String?             @db.VarChar(200)
  department        String?             @db.VarChar(200)
  organization      String?             @db.VarChar(200)
  avatarUrl         String?             @map("avatar_url") @db.VarChar(500)
  status            String              @default("active") @db.VarChar(20)
  lastLoginAt       DateTime?           @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime?           @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  notifications     Notification[]
  signatureRecords  SignatureRecord[]
  siteStaff         SiteStaff[]
  auditLogs         AuditLog[]          @relation("AuditUser")
  userRoles         UserRole[]
  wechatBindings    WechatUserBinding[]
  doctorPatients    DoctorPatientRecord[]

  @@map("users")
}

model Role {
  id              String           @id @default(uuid())
  roleCode        String           @unique @map("role_code") @db.VarChar(50)
  roleName        String           @map("role_name") @db.VarChar(100)
  description     String?          @db.VarChar(500)
  isSystemRole    Boolean          @default(false) @map("is_system_role")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id") @db.VarChar(36)
  roleId    String   @map("role_id") @db.VarChar(36)
  projectId String?  @map("project_id") @db.VarChar(36)
  siteId    String?  @map("site_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, projectId, siteId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Permission {
  id                 String           @id @default(uuid())
  permissionCode     String           @unique @map("permission_code") @db.VarChar(100)
  permissionName     String           @map("permission_name") @db.VarChar(200)
  permissionType     String           @map("permission_type") @db.VarChar(20)
  resourceType       String?          @map("resource_type") @db.VarChar(50)
  actionType         String?          @map("action_type") @db.VarChar(50)
  description        String?          @db.VarChar(500)
  isSystemPermission Boolean          @default(false) @map("is_system_permission")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  rolePermissions    RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id            String     @id @default(uuid())
  roleId        String     @map("role_id") @db.VarChar(36)
  permissionId  String     @map("permission_id") @db.VarChar(36)
  resourceScope String     @default("all") @map("resource_scope") @db.VarChar(20)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

model Organization {
  id                   String   @id @default(uuid())
  orgCode              String   @unique @map("org_code") @db.VarChar(100)
  orgName              String   @map("org_name") @db.VarChar(200)
  orgType              String   @map("org_type") @db.VarChar(50)
  address              String?  @db.VarChar(500)
  contactPerson        String?  @map("contact_person") @db.VarChar(200)
  contactPhone         String?  @map("contact_phone") @db.VarChar(50)
  status               String   @default("active") @db.VarChar(20)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  city                 String?  @db.VarChar(100)
  contactEmail         String?  @map("contact_email") @db.VarChar(200)
  country              String?  @default("China") @db.VarChar(50)
  description          String?
  parentId             String?  @map("parent_id") @db.VarChar(36)
  province             String?  @db.VarChar(100)
  shortName            String?  @map("short_name") @db.VarChar(100)
  sortOrder            Int      @default(0) @map("sort_order")
  gcpContactName       String?  @map("gcp_contact_name") @db.VarChar(200)
  gcpContactPhone      String?  @map("gcp_contact_phone") @db.VarChar(50)
  researchContactName  String?  @map("research_contact_name") @db.VarChar(200)
  researchContactPhone String?  @map("research_contact_phone") @db.VarChar(50)
  investigatorName     String?  @map("investigator_name") @db.VarChar(200)

  @@index([orgType])
  @@index([status])
  @@index([parentId])
  @@map("organizations")
}

model Project {
  id                   String                   @id @default(uuid())
  projectCode          String                   @unique @map("project_code") @db.VarChar(100)
  projectName          String                   @map("project_name") @db.VarChar(200)
  description          String?
  studyType            String?                  @map("study_type") @db.VarChar(50)
  therapeuticArea      String?                  @map("therapeutic_area") @db.VarChar(200)
  indication           String?                  @db.VarChar(300)
  blindType            String?                  @map("blind_type") @db.VarChar(50)
  sampleSize           Int?                     @map("sample_size")
  startDate            DateTime?                @map("start_date") @db.Date
  endDate              DateTime?                @map("end_date") @db.Date
  totalBudget          Float?                   @map("total_budget")
  currency             String?                  @default("CNY") @db.VarChar(10)
  status               String                   @default("draft") @db.VarChar(20)
  statusReason         String?                  @map("status_reason") @db.VarChar(500)
  createdBy            String                   @map("created_by") @db.VarChar(36)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  phase                String?                  @db.VarChar(20)
  consentRecords       ConsentRecord[]
  crfForms             CrfForm[]
  dataQueries          DataQuery[]
  dataSyncLogs         DataSyncLog[]
  drugs                Drug[]
  lockRecords          EdcLockRecord[]
  randomizationRecords EdcRandomizationRecord[]
  templates            EdcTemplate[]
  editCheckExecutions  EditCheckExecution[]
  ethicsApprovals      EthicsApproval[]
  milestones           Milestone[]
  monitoringPlans      MonitoringPlan[]
  monitoringVisits     MonitoringVisit[]
  sites                Site[]
  subjects             Subject[]
  tmfDocuments         TmfDocument[]
  auditLogs            AuditLog[]               @relation("AuditProject")
  visits               Visit[]

  @@index([status])
  @@map("projects")
}

model Milestone {
  id            String    @id @default(uuid())
  projectId     String    @map("project_id") @db.VarChar(36)
  milestoneName String    @map("milestone_name") @db.VarChar(200)
  milestoneType String    @map("milestone_type") @db.VarChar(50)
  plannedDate   DateTime  @map("planned_date") @db.Date
  actualDate    DateTime? @map("actual_date") @db.Date
  status        String    @default("pending") @db.VarChar(20)
  description   String?
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("milestones")
}

model Site {
  id                   String            @id @default(uuid())
  projectId            String?           @map("project_id") @db.VarChar(36)
  siteCode             String            @map("site_code") @db.VarChar(100)
  siteName             String            @map("site_name") @db.VarChar(200)
  piUserId             String?           @map("pi_user_id") @db.VarChar(36)
  address              String?           @db.VarChar(500)
  contactPhone         String?           @map("contact_phone") @db.VarChar(50)
  ethicsStatus         String?           @map("ethics_status") @db.VarChar(50)
  ethicsApproveDate    DateTime?         @map("ethics_approve_date") @db.Date
  contractStatus       String?           @map("contract_status") @db.VarChar(50)
  plannedSampleSize    Int?              @map("planned_sample_size")
  gcpContactName       String?           @map("gcp_contact_name") @db.VarChar(200)
  gcpContactPhone      String?           @map("gcp_contact_phone") @db.VarChar(50)
  researchContactName  String?           @map("research_contact_name") @db.VarChar(200)
  researchContactPhone String?           @map("research_contact_phone") @db.VarChar(50)
  status               String            @default("pending") @db.VarChar(20)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  consentRecords       ConsentRecord[]
  ethicsApprovals      EthicsApproval[]
  monitoringVisits     MonitoringVisit[]
  siteStaff            SiteStaff[]
  project              Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subjects             Subject[]
  visits               Visit[]

  @@unique([projectId, siteCode])
  @@index([projectId])
  @@map("sites")
}

model SiteStaff {
  id         String    @id @default(uuid())
  siteId     String    @map("site_id") @db.VarChar(36)
  userId     String    @map("user_id") @db.VarChar(36)
  roleAtSite String    @map("role_at_site") @db.VarChar(50)
  joinedAt   DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt     DateTime? @map("left_at") @db.Timestamptz(6)
  status     String    @default("active") @db.VarChar(20)
  site       Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, userId])
  @@index([siteId])
  @@map("site_staff")
}

model MonitoringPlan {
  id               String            @id @default(uuid())
  projectId        String            @map("project_id") @db.VarChar(36)
  planName         String            @map("plan_name") @db.VarChar(200)
  frequency        String?           @db.VarChar(100)
  description      String?
  status           String            @default("draft") @db.VarChar(20)
  createdBy        String            @map("created_by") @db.VarChar(36)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  monitoringVisits MonitoringVisit[]

  @@index([projectId])
  @@map("monitoring_plans")
}

model MonitoringVisit {
  id            String          @id @default(uuid())
  planId        String?         @map("plan_id") @db.VarChar(36)
  projectId     String          @map("project_id") @db.VarChar(36)
  siteId        String?         @map("site_id") @db.VarChar(36)
  craUserId     String          @map("cra_user_id") @db.VarChar(36)
  visitType     String          @map("visit_type") @db.VarChar(50)
  plannedDate   DateTime        @map("planned_date") @db.Date
  actualDate    DateTime?       @map("actual_date") @db.Date
  status        String          @default("planned") @db.VarChar(20)
  sdvPercentage Float?          @map("sdv_percentage")
  reportId      String?         @map("report_id") @db.VarChar(36)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  plan          MonitoringPlan? @relation(fields: [planId], references: [id])
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site          Site?           @relation(fields: [siteId], references: [id])

  @@index([projectId])
  @@map("monitoring_visits")
}

model Timesheet {
  id              String           @id @default(uuid())
  userId          String           @map("user_id") @db.VarChar(36)
  projectId       String?          @map("project_id") @db.VarChar(36)
  weekStartDate   DateTime         @map("week_start_date") @db.Date
  totalHours      Float            @map("total_hours")
  status          String           @default("draft") @db.VarChar(20)
  submittedAt     DateTime?        @map("submitted_at") @db.Timestamptz(6)
  approvedBy      String?          @map("approved_by") @db.VarChar(36)
  approvedAt      DateTime?        @map("approved_at") @db.Timestamptz(6)
  rejectionReason String?          @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  entries         TimesheetEntry[]

  @@index([userId, weekStartDate])
  @@map("timesheets")
}

model TimesheetEntry {
  id          String    @id @default(uuid())
  timesheetId String    @map("timesheet_id") @db.VarChar(36)
  workDate    DateTime  @map("work_date") @db.Date
  hours       Float
  workType    String    @map("work_type") @db.VarChar(20)
  projectId   String?   @map("project_id") @db.VarChar(36)
  siteId      String?   @map("site_id") @db.VarChar(36)
  description String?   @db.VarChar(500)
  isBillable  Boolean   @default(true) @map("is_billable")
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@index([timesheetId])
  @@map("timesheet_entries")
}

model FinancialIncome {
  id           String    @id @default(uuid())
  projectId    String?   @map("project_id") @db.VarChar(36)
  incomeCode   String    @unique @map("income_code") @db.VarChar(100)
  incomeType   String    @map("income_type") @db.VarChar(20)
  description  String?   @db.VarChar(300)
  amount       Float
  currency     String    @default("CNY") @db.VarChar(10)
  expectedDate DateTime? @map("expected_date") @db.Date
  receivedDate DateTime? @map("received_date") @db.Date
  status       String    @default("pending") @db.VarChar(20)
  invoiceId    String?   @map("invoice_id") @db.VarChar(36)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([projectId])
  @@map("financial_incomes")
}

model FinancialExpense {
  id                  String   @id @default(uuid())
  projectId           String?  @map("project_id") @db.VarChar(36)
  expenseCode         String   @unique @map("expense_code") @db.VarChar(100)
  expenseType         String   @map("expense_type") @db.VarChar(20)
  description         String?  @db.VarChar(300)
  amount              Float
  currency            String   @default("CNY") @db.VarChar(10)
  expenseDate         DateTime @map("expense_date") @db.Date
  submittedBy         String   @map("submitted_by") @db.VarChar(36)
  status              String   @default("pending") @db.VarChar(20)
  reimbursementStatus String?  @map("reimbursement_status") @db.VarChar(20)
  invoiceUrl          String?  @map("invoice_url") @db.VarChar(500)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([projectId])
  @@index([submittedBy])
  @@map("financial_expenses")
}

model Subject {
  id                    String                  @id @default(uuid())
  projectId             String                  @map("project_id") @db.VarChar(36)
  siteId                String?                 @map("site_id") @db.VarChar(36)
  subjectCode           String                  @map("subject_code") @db.VarChar(100)
  screeningNumber       String?                 @map("screening_number") @db.VarChar(100)
  randomizationNumber   String?                 @map("randomization_number") @db.VarChar(50)
  enrollmentStatus      String                  @default("screening") @map("enrollment_status") @db.VarChar(20)
  screeningFailedReason String?                 @map("screening_failed_reason") @db.VarChar(500)
  enrolledAt            DateTime?               @map("enrolled_at") @db.Timestamptz(6)
  discontinuedAt        DateTime?               @map("discontinued_at") @db.Timestamptz(6)
  discontinuationReason String?                 @map("discontinuation_reason") @db.VarChar(500)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  crfData               CrfData[]
  queries               DataQuery[]
  randRecord            EdcRandomizationRecord?
  project               Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site                  Site?                   @relation(fields: [siteId], references: [id])
  visits                Visit[]

  @@unique([projectId, subjectCode])
  @@index([projectId])
  @@index([enrollmentStatus])
  @@map("subjects")
}

model Visit {
  id             String    @id @default(uuid())
  projectId      String    @map("project_id") @db.VarChar(36)
  subjectId      String?   @map("subject_id") @db.VarChar(36)
  siteId         String?   @map("site_id") @db.VarChar(36)
  visitCode      String    @map("visit_code") @db.VarChar(100)
  visitName      String    @map("visit_name") @db.VarChar(200)
  plannedDate    DateTime? @map("planned_date") @db.Date
  actualDate     DateTime? @map("actual_date") @db.Date
  status         String    @default("planned") @db.VarChar(20)
  isSDVCompleted Boolean   @default(false) @map("is_sdv_completed")
  sdvCompletedBy String?   @map("sdv_completed_by") @db.VarChar(36)
  sdvCompletedAt DateTime? @map("sdv_completed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site           Site?     @relation(fields: [siteId], references: [id])
  subject        Subject?  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([subjectId])
  @@map("visits")
}

model EdcTemplate {
  id               String    @id @default(uuid())
  templateCode     String    @unique @map("template_code") @db.VarChar(100)
  templateName     String    @map("template_name") @db.VarChar(200)
  templateType     String    @map("template_type") @db.VarChar(20)
  therapeuticArea  String?   @map("therapeutic_area") @db.VarChar(100)
  indication       String?   @db.VarChar(200)
  description      String?
  version          String    @default("1.0") @db.VarChar(20)
  isSystemTemplate Boolean   @default(false) @map("is_system_template")
  isShared         Boolean   @default(false) @map("is_shared")
  ownerUserId      String?   @map("owner_user_id") @db.VarChar(36)
  projectId        String?   @map("project_id") @db.VarChar(36)
  templateData     Json      @default("{}") @map("template_data")
  usageCount       Int       @default(0) @map("usage_count")
  status           String    @default("draft") @db.VarChar(20)
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  publishedBy      String?   @map("published_by") @db.VarChar(36)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  project          Project?  @relation(fields: [projectId], references: [id])

  @@index([templateType])
  @@map("edc_templates")
}

model CrfData {
  id                String           @id @default(uuid())
  subjectId         String           @map("subject_id") @db.VarChar(36)
  visitId           String?          @map("visit_id") @db.VarChar(36)
  formId            String           @map("form_id") @db.VarChar(100)
  formCode          String           @map("form_code") @db.VarChar(100)
  fieldId           String           @map("field_id") @db.VarChar(100)
  fieldCode         String           @map("field_code") @db.VarChar(100)
  fieldValue        String?          @map("field_value")
  rawValue          Json?            @map("raw_value")
  standardizedValue Json?            @map("standardized_value")
  formData          Json?            @map("form_data")
  cdiscDomain       String?          @map("cdisc_domain") @db.VarChar(10)
  cdashDataset      String?          @map("cdash_dataset") @db.VarChar(50)
  cdashVariable     String?          @map("cdash_variable") @db.VarChar(40)
  sdtmVariable      String?          @map("sdtm_variable") @db.VarChar(40)
  codeListOid       String?          @map("code_list_oid") @db.VarChar(100)
  collectionVersion String?          @map("collection_version") @db.VarChar(20)
  enteredBy         String           @map("entered_by") @db.VarChar(36)
  enteredAt         DateTime         @default(now()) @map("entered_at") @db.Timestamptz(6)
  updatedBy         String?          @map("updated_by") @db.VarChar(36)
  updatedAt         DateTime?        @map("updated_at") @db.Timestamptz(6)
  isDeleted         Boolean          @default(false) @map("is_deleted")
  deletedBy         String?          @map("deleted_by") @db.VarChar(36)
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(6)
  auditTrail        Json?            @map("audit_trail")
  esigStatus        String?          @map("esig_status") @db.VarChar(20)
  esigSignedBy      String?          @map("esig_signed_by") @db.VarChar(36)
  esigSignedAt      DateTime?        @map("esig_signed_at") @db.Timestamptz(6)
  subject           Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  histories         CrfDataHistory[]

  @@index([subjectId, formCode])
  @@index([cdiscDomain, cdashVariable])
  @@index([enteredBy])
  @@map("crf_data")
}

model CrfDataHistory {
  id           String   @id @default(uuid())
  crfDataId    String   @map("crf_data_id") @db.VarChar(36)
  fieldId      String   @map("field_id") @db.VarChar(100)
  oldValue     Json?    @map("old_value")
  newValue     Json?    @map("new_value")
  changeReason String?  @map("change_reason") @db.VarChar(500)
  changedBy    String   @map("changed_by") @db.VarChar(36)
  changedAt    DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  crfData      CrfData  @relation(fields: [crfDataId], references: [id], onDelete: Cascade)

  @@index([crfDataId])
  @@map("crf_data_history")
}

model DataQuery {
  id              String             @id @default(uuid())
  projectId       String             @map("project_id") @db.VarChar(36)
  subjectId       String?            @map("subject_id") @db.VarChar(36)
  visitId         String?            @map("visit_id") @db.VarChar(36)
  formId          String?            @map("form_id") @db.VarChar(100)
  fieldId         String?            @map("field_id") @db.VarChar(100)
  queryType       String             @map("query_type") @db.VarChar(50)
  priority        String             @default("normal") @db.VarChar(20)
  title           String             @map("title") @db.VarChar(300)
  description     String
  assignedTo      String?            @map("assigned_to") @db.VarChar(36)
