# CTMS+EDC+IWRS 平台 - .gitignore 文件

# ==================== 环境变量 ====================
.env
.env.local
.env.*.local

# ==================== 节点模块 ====================
node_modules/
.pnp
.pnp.js

# ==================== 构建输出 ====================
dist/
build/
*.log

# ==================== Docker ====================
*.pid
*.seed
*.pid.lock

# ==================== 调试 ====================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ==================== 测试 ====================
coverage/
.nyc_output/

# ==================== IDE ====================
.vscode/
.idea/
*.swp
*.swo
*~

# ==================== 操作系统 ====================
.DS_Store
Thumbs.db
desktop.ini

# ==================== 临时文件 ====================
tmp/
temp/
*.tmp
*.temp

# ==================== 上传文件 ====================
uploads/
*.pdf
*.xlsx
*.csv
!.gitignore

# ==================== 数据库文件 ====================
*.db
*.sqlite
*.sqlite3

# ==================== 证书和密钥 ====================
*.pem
*.key
*.crt
!.gitignore
secrets/
credentials/

# ==================== 日志 ====================
logs/
*.log

# ==================== TypeScript ====================
*.tsbuildinfo

# ==================== 全局 package.json ====================
package.json
yarn.lock
pnpm-lock.yaml
