# CTMS+EDC+IWRS 平台 - 环境变量配置
# 复制此文件为 .env 并根据实际环境修改

# ==================== 通用配置 ====================
NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Shanghai

# ==================== PostgreSQL 数据库 ====================
POSTGRES_USER=ctms
POSTGRES_PASSWORD=ctms123456
POSTGRES_DB=ctms_edc_iwrs
POSTGRES_PORT=5432

# ==================== Redis 缓存 ====================
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ==================== MinIO 对象存储 ====================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=ctms-files

# ==================== RabbitMQ 消息队列 ====================
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ==================== Nginx API 网关 ====================
NGINX_PORT=80
NGINX_SSL_PORT=443

# ==================== Elasticsearch & Kibana ====================
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601

# ==================== Prometheus & Grafana ====================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ==================== JWT 认证 ====================
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRATION=7d

# ==================== 微服务端口 ====================
AUTH_SERVICE_PORT=3001
CTMS_SERVICE_PORT=3002
EDC_SERVICE_PORT=3003
IWRS_SERVICE_PORT=3004
PORTFOLIO_SERVICE_PORT=3005
DOCUMENT_SERVICE_PORT=3006
REPORTING_SERVICE_PORT=3007
NOTIFICATION_SERVICE_PORT=3008
SECURITY_SERVICE_PORT=3009
INTEGRATION_SERVICE_PORT=3010
CONFIG_SERVICE_PORT=3011
VALIDATION_SERVICE_PORT=3012

# ==================== 前端端口 ====================
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:80
VITE_AUTH_SERVICE_URL=http://localhost:3001

# ==================== 企业微信通知 ====================
# 在企业微信开发者平台创建应用后获取
WECHAT_CORP_ID=
WECHAT_SECRET=
WECHAT_AGENT_ID=

# ==================== SMTP 邮件通知 ====================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ctms-platform.com

# ==================== HL7/FHIR集成 ====================
HL7_ENDPOINT=
FHIR_ENDPOINT=

# ==================== 生产环境安全建议 ====================
# 1. 修改所有默认密码
# 2. 使用强密码（32 位以上，包含大小写字母、数字、符号）
# 3. JWT_SECRET 使用随机生成的密钥
# 4. 启用 HTTPS（生成 SSL 证书并配置 Nginx）
# 5. 数据库密码不要提交到版本控制
# 6. 使用 Docker Secrets 或 Kubernetes Secrets 管理敏感信息
# 7. 定期轮换密钥

# ==================== 数据库连接 URL（自动生成） ====================
# Auth 服务数据库
DATABASE_AUTH_URL=postgresql://ctms:ctms123456@localhost:5432/ctms_edc_iwrs_auth

# CTMS 服务数据库
DATABASE_CTMS_URL=postgresql://ctms:ctms123456@localhost:5432/ctms_edc_iwrs_ctms

# EDC 服务数据库
DATABASE_EDC_URL=postgresql://ctms:ctms123456@localhost:5432/ctms_edc_iwrs_edc

# IWRS 服务数据库
DATABASE_IWRS_URL=postgresql://ctms:ctms123456@localhost:5432/ctms_edc_iwrs_iwrs

# Portfolio 服务数据库
DATABASE_PORTFOLIO_URL=postgresql://ctms:ctms123456@localhost:5432/ctms_edc_iwrs_portfolio

# Document 服务数据库
DATABASE_DOCUMENT_URL=postgresql://ctms:ctms123456@localhost:5432/ctms_edc_iwrs_document

# Reporting 服务数据库
DATABASE_REPORTING_URL=postgresql://ctms:ctms123456@localhost:5432/ctms_edc_iwrs_reporting

# Security 服务数据库
DATABASE_SECURITY_URL=postgresql://ctms:ctms123456@localhost:5432/ctms_edc_iwrs_security

# Config 服务数据库
DATABASE_CONFIG_URL=postgresql://ctms:ctms123456@localhost:5432/ctms_edc_iwrs_config

# Validation 服务数据库
DATABASE_VALIDATION_URL=postgresql://ctms:ctms123456@localhost:5432/ctms_edc_iwrs_validation
